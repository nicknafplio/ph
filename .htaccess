# Pigeon Hill Advisory — Apache configuration (SiteGround)
#
# SiteGround puts NGINX in front of Apache and lets it answer static requests itself.
# "NGINX Direct Delivery" is on by default and covers images, CSS, JS and plain HTML
# documents — which on a static site is everything. Those requests never reach Apache
# and so never read this file. Caching and compression are therefore left to NGINX
# rather than set here, where they would look configured but do nothing.
#
# HTTPS is enforced in Site Tools > Security > HTTPS Enforce, not below: that switch
# writes its own rewrite rules, and a second copy here would mean two redirects on
# every request.
#
# What remains works because it applies to requests NGINX cannot answer from disk.

# A URL with no file behind it misses NGINX and falls through to Apache, so this fires.
ErrorDocument 404 /404.html

# The site is static, so the listing a missing index would otherwise produce is never wanted.
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Canonical host: fold www into the apex in one hop.
  # Verify this after upload by requesting https://www.pigeonhilladvisory.co.uk/ — if it
  # does not land on the apex, NGINX answered before Apache saw the request; set the
  # redirect in Site Tools > Domain > Redirects instead, which runs at the right layer.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]
</IfModule>

# Only reaches the browser on responses Apache serves, so treat these as a backstop
# rather than the site's security headers. To apply them to every response, turn off
# NGINX Direct Delivery in Site Tools > Speed > Caching — at a real cost in speed,
# which for a brochure site is unlikely to be worth it.
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
