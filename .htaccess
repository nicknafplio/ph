# Pigeon Hill Advisory — Apache configuration
# Requires mod_rewrite, mod_headers, mod_deflate and mod_expires. On shared hosting
# (cPanel, Plesk) these are normally on; if a directive is unavailable the server may
# return 500, so comment out the offending block rather than the whole file.

ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Canonical host: www and the apex both resolve, so send www to the apex in one hop.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # Force HTTPS. HTTP:X-Forwarded-Proto covers hosts that terminate TLS at a proxy,
  # where HTTPS alone reads "off" and would otherwise loop.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>

# The site is static, so the directory listing a missing index would produce is never wanted.
Options -Indexes

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  # Fonts and images are fingerprinted by name only, so a year is safe for them but not
  # for the HTML that points at them.
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
</IfModule>

<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType font/ttf .ttf
  AddType image/svg+xml .svg
</IfModule>
